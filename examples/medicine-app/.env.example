CAREVAULT_URL=http://127.0.0.1:3040
CAREVAULT_TOKEN=replace_with_this_apps_integration_token
OPENROUTER_API_KEY=replace_locally
# Explicit model; startup never chooses a fallback. GPT-6.1 Sol allows up to $2/M input and $10/M output; other models must be free.
OPENROUTER_MODEL=openai/gpt-6.1-sol
MEDICINE_APP_USERNAME=demo
MEDICINE_APP_PASSWORD=replace_with_a_unique_password_at_least_12_characters
