{
  "name": "carevault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "setup": "node --experimental-strip-types scripts/setup.ts",
    "dev": "next dev --hostname 127.0.0.1 --port 3040",
    "build": "next build --webpack",
