    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": { "next": "16.3.8", "react": "19.3.0", "react-dom": "19.3.0", "lucide-react": "^0.468.0" },
  "devDependencies": { "typescript": "^5.9.3", "@types/node": "^24.0.0", "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0" }
}
